{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["infra/cdk.ts"],
  "exclude": ["node_modules", "cdk.out", "dist"]
}
